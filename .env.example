# ---- Copy to .env and change every value marked CHANGE ----
# PostgreSQL (used by docker-compose AND by the app when run locally)
POSTGRES_USER=educore
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=educore
# Local run (outside Docker). Inside Docker, compose overrides host to "db".
DATABASE_URL=postgresql+psycopg2://educore:CHANGE_ME_db_password@localhost:5432/educore

# JWT signing key (>= 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business rule: attendance % below this is flagged
ATTENDANCE_THRESHOLD=75

# Seed script only (demo data). Password given to every seeded account.
SEED_DEFAULT_PASSWORD=CHANGE_ME_demo_password1

# ---- Optional AI learning assistant (main ERP works without any of this) ----
AI_ENABLED=false
# Leave empty to get "extractive" answers (best matching passages, no LLM)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
MAX_UPLOAD_MB=10
